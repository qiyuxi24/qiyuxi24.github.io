# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore CodeBuddy workspace memory
.codebuddy/

# Ignore legacy Jekyll template backup (kept locally for rollback only)
_legacy_jekyll/

# Ignore playwright-cli local test artifacts
.playwright-cli/

# Ignore ad-hoc debug scripts / screenshots at repo root (e.g. _check_*.js, _shot.js, view-*.png)
/_*.js
/view-*.png

# Ignore files created by MacOS
.DS_Store
